@model ec.edu.monster.modelo.LoginModel
@{
    ViewData["Title"] = "Inicio de sesión";
}

<link rel="stylesheet" href="~/css/converter.css" asp-append-version="true" />

<div class="login-wrapper">
    <div class="login-card">

        <div class="logo-container">
            <img src="~/images/logo.png" alt="Logo" class="login-logo" />
        </div>

        <h1>Control de Acceso</h1>
        <p class="subtitle">Tu pase a las conversiones cuánticas</p>

        <form asp-action="Index" method="post" class="login-form">
            <div class="field">
                <label asp-for="Usuario"></label>
                <input asp-for="Usuario" autocomplete="username" />
                <span class="validation" asp-validation-for="Usuario"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" autocomplete="current-password" />
                <span class="validation" asp-validation-for="Password"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert">@Model.Error</div>
            }

            <div class="actions">
                <button type="submit">Ingresar</button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
