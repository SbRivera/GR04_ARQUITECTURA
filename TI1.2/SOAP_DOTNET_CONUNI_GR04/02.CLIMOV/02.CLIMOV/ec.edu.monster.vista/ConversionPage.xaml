<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_02.CLIMOV.Vista.ConversionPage"
             Title="Conversión de Unidades"
             Shell.NavBarIsVisible="False">

    <!-- Fondo con gradiente morado vibrante -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0E7FF" Offset="0.0" />
            <GradientStop Color="#DDD6FE" Offset="0.4" />
            <GradientStop Color="#C4B5FD" Offset="0.7" />
            <GradientStop Color="#A78BFA" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header con usuario -->
            <Frame CornerRadius="20"
                   HasShadow="True"
                   Padding="20,15"
                   BorderColor="Transparent"
                   Margin="0,10,0,0">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7C3AED" Offset="0.0" />
                        <GradientStop Color="#A78BFA" Offset="1.0" />
                    </LinearGradientBrush>
                </Frame.Background>
                
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="📊"
                           FontSize="32"
                           VerticalOptions="Center"/>
                    
                    <VerticalStackLayout Grid.Column="1" 
                                       Spacing="3" 
                                       VerticalOptions="Center">
                        <Label Text="Sistema de Conversión"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"/>
                        <Label x:Name="LabelUsuario"
                               FontSize="14"
                               TextColor="#F3F4F6"
                               Opacity="0.95"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            x:Name="BtnCerrarSesion"
                            Text="Salir"
                            Clicked="OnCerrarSesionClicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#7C3AED"
                            CornerRadius="10"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="18,10"
                            VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Selector de Tipo de Conversión -->
            <Frame CornerRadius="18"
                   HasShadow="True"
                   Padding="20"
                   BackgroundColor="#FFFFFF"
                   BorderColor="Transparent">

                <VerticalStackLayout Spacing="12">
                    <Label Text="Tipo de Conversión"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#6B46C1"/>

                    <Border Stroke="#8B5CF6"
                            StrokeThickness="2"
                            BackgroundColor="#F9FAFB"
                            Padding="12,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Picker x:Name="PickerTipoConversion"
                                FontSize="16"
                                TextColor="#1F2937"
                                FontAttributes="Bold"
                                SelectedIndexChanged="OnTipoConversionChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>📏 Longitud</x:String>
                                    <x:String>🌡️ Temperatura</x:String>
                                    <x:String>⚖️ Peso</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Frame>

            <!-- Card Principal de Conversión -->
            <Frame CornerRadius="18"
                   HasShadow="True"
                   Padding="25"
                   BackgroundColor="#FFFFFF"
                   BorderColor="Transparent">

                <VerticalStackLayout Spacing="18">

                    <!-- Valor a convertir -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Valor a Convertir"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6B46C1"/>

                        <Border Stroke="#8B5CF6"
                                StrokeThickness="2"
                                BackgroundColor="#F9FAFB"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Entry x:Name="EntryValor"
                                   Placeholder="Ingrese el valor"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#1F2937"
                                   Keyboard="Numeric"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   ClearButtonVisibility="WhileEditing"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Unidad Origen -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Desde"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6B46C1"/>

                        <Border Stroke="#A78BFA"
                                StrokeThickness="2"
                                BackgroundColor="#F9FAFB"
                                Padding="12,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Picker x:Name="PickerOrigen"
                                    FontSize="16"
                                    TextColor="#1F2937"
                                    FontAttributes="Bold"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Icono de conversión -->
                    <Label Text="⇅"
                           FontSize="40"
                           FontAttributes="Bold"
                           TextColor="#7C3AED"
                           HorizontalOptions="Center"
                           Margin="0,8"/>

                    <!-- Unidad Destino -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Hacia"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6B46C1"/>

                        <Border Stroke="#A78BFA"
                                StrokeThickness="2"
                                BackgroundColor="#F9FAFB"
                                Padding="12,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Picker x:Name="PickerDestino"
                                    FontSize="16"
                                    TextColor="#1F2937"
                                    FontAttributes="Bold"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botones de acción -->
                    <Grid ColumnDefinitions="*,Auto" 
                          ColumnSpacing="12"
                          Margin="0,10,0,0">

                        <Button x:Name="BtnConvertir"
                                Grid.Column="0"
                                Text="CONVERTIR"
                                Clicked="OnConvertirClicked"
                                HeightRequest="55"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="White"
                                CornerRadius="12">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7C3AED" Offset="0.0" />
                                    <GradientStop Color="#A78BFA" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Shadow>
                                <Shadow Brush="#7C3AED"
                                        Opacity="0.4"
                                        Radius="8"
                                        Offset="0,3"/>
                            </Button.Shadow>
                        </Button>

                        <Button x:Name="BtnLimpiar"
                                Grid.Column="1"
                                Text="🗑️"
                                Clicked="OnLimpiarClicked"
                                BackgroundColor="#E5E7EB"
                                TextColor="#6B7280"
                                CornerRadius="12"
                                WidthRequest="55"
                                HeightRequest="55"
                                FontSize="22"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                     IsRunning="False"
                                     IsVisible="False"
                                     Color="#7C3AED"
                                     HeightRequest="45"
                                     Margin="0,10"/>

                    <!-- Frame de Resultado -->
                    <Frame x:Name="FrameResultado"
                           BorderColor="Transparent"
                           CornerRadius="15"
                           Padding="20"
                           Margin="0,10,0,0"
                           IsVisible="False"
                           HasShadow="True">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0.0" />
                                <GradientStop Color="#059669" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="✨ Resultado de la Conversión"
                                   FontSize="15"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   Opacity="0.95"/>
                            
                            <Label x:Name="LabelResultado"
                                   FontSize="28"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,5,0,0"/>
                            
                            <Label x:Name="LabelDetalles"
                                   FontSize="14"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   Opacity="0.9"
                                   Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- Info Footer -->
            <Frame BackgroundColor="#FFFFFF"
                   BorderColor="Transparent"
                   CornerRadius="15"
                   Padding="15"
                   HasShadow="True"
                   Margin="0,5,0,20">
                <Label TextColor="#7C3AED"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="✨ " FontSize="16"/>
                            <Span Text="Powered by SOAP Web Services" FontAttributes="Bold"/>
                            <Span Text="&#x0a;Sistema de conversión en tiempo real" TextColor="#6B7280"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
