<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_02.CLIMOV.Vista.LoginPage"
             Shell.NavBarIsVisible="False">

    <!-- Fondo con gradiente morado elegante -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6B46C1" Offset="0.0" />
            <GradientStop Color="#8B5CF6" Offset="0.3" />
            <GradientStop Color="#A78BFA" Offset="0.7" />
            <GradientStop Color="#C4B5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid Padding="20" RowDefinitions="Auto,*,Auto" VerticalOptions="Center">

            <!-- Header con Logo Visual Studio Style -->
            <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,40,0,30">
                <Image Source="perfil.jpg"
                       HeightRequest="120"
                       WidthRequest="120"
                       Aspect="AspectFill"
                       HorizontalOptions="Center">
                    <Image.Clip>
                        <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                    </Image.Clip>
                </Image>

                <Label Text="Conversion App"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#FFFFFF"
                       Margin="0,5,0,0"/>

                <Label Text="Sistema de Conversión de Unidades"
                       FontSize="15"
                       HorizontalOptions="Center"
                       TextColor="#F3F4F6"
                       Opacity="0.95"/>
            </VerticalStackLayout>

            <!-- Card de Login con estilo moderno -->
            <Frame Grid.Row="1"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="0"
                   BackgroundColor="#FFFFFF"
                   BorderColor="Transparent"
                   Margin="10,0">

                <VerticalStackLayout Padding="30,25" Spacing="20">

                    <!-- Título -->
                    <Label Text="Iniciar Sesión"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#6B46C1"
                           HorizontalOptions="Center"
                           Margin="0,0,0,15"/>

                    <!-- Campo Usuario -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Usuario"
                               FontSize="14"
                               TextColor="#6B46C1"
                               FontAttributes="Bold"/>
                        
                        <Border Stroke="#8B5CF6"
                                StrokeThickness="2"
                                BackgroundColor="#F9FAFB"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>

                            <Entry x:Name="EntryUsuario"
                                   Placeholder="Ingrese su usuario"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#1F2937"
                                   FontSize="16"
                                   ClearButtonVisibility="WhileEditing"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña"
                               FontSize="14"
                               TextColor="#6B46C1"
                               FontAttributes="Bold"/>
                        
                        <Border Stroke="#8B5CF6"
                                StrokeThickness="2"
                                BackgroundColor="#F9FAFB"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>

                            <Entry x:Name="EntryPassword"
                                   Placeholder="Ingrese su contraseña"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#1F2937"
                                   FontSize="16"
                                   IsPassword="True"
                                   ClearButtonVisibility="WhileEditing"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botón Login con gradiente morado -->
                    <Button x:Name="BtnLogin"
                            Text="INGRESAR"
                            Clicked="OnLoginClicked"
                            HeightRequest="55"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="White"
                            CornerRadius="12"
                            Margin="0,15,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7C3AED" Offset="0.0" />
                                <GradientStop Color="#A78BFA" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="#7C3AED"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,4"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Loading Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                     IsRunning="False"
                                     IsVisible="False"
                                     Color="#7C3AED"
                                     HeightRequest="40"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Footer con mensaje elegante -->
            <Label Grid.Row="2"
                   Margin="10,20,10,20"
                   HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="✨ " 
                              FontSize="16"/>
                        <Span Text="Bienvenido al sistema de conversión"
                              FontSize="14"
                              TextColor="White"
                              FontAttributes="Bold"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </Grid>
    </ScrollView>

</ContentPage>