@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .login-card {
            background: white;
            border-radius: 2rem;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            max-width: 1100px;
            width: 100%;
        }
        .image-section {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.95) 0%, rgba(118, 75, 162, 0.95) 100%);
            position: relative;
            overflow: hidden;
        }
        .image-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('/Perfil.jpg');
            background-size: cover;
            background-position: center;
            opacity: 0.3;
            z-index: 0;
        }
        .image-content {
            position: relative;
            z-index: 1;
        }
        .input-group {
            position: relative;
        }
        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #9333ea;
            z-index: 10;
        }
        .input-field {
            padding-left: 48px;
        }
        .input-field:focus {
            outline: none;
            border-color: #9333ea;
            box-shadow: 0 0 0 3px rgba(147, 51, 234, 0.1);
        }
        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: all 0.3s ease;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        .float-icon {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card grid md:grid-cols-2 animate-fade-in-up">
            <!-- Left Side - Image & Info -->
            <div class="image-section p-12 flex flex-col justify-center items-center text-white relative">
                <div class="image-content text-center space-y-6">
                    <!-- Profile Image -->
                    <div class="mb-8">
                        <div class="relative inline-block">
                            <img src="/Perfil.jpg" alt="Profile" class="w-48 h-48 rounded-full object-cover border-8 border-white shadow-2xl">
                            <div class="absolute -bottom-2 -right-2 bg-white rounded-full p-3 shadow-lg float-icon">
                                <i class="fa-brands fa-microsoft text-purple-600 text-3xl"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Welcome Text -->
                    <div>
                        <h1 class="text-4xl font-bold mb-3">
                            ¡Bienvenido de vuelta!
                        </h1>
                        <p class="text-xl text-purple-100 mb-6">
                            ConUni Converter
                        </p>
                        <div class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-6 py-2">
                            <p class="text-sm font-semibold">
                                <i class="fas fa-server mr-2"></i>
                                Powered by .NET 8.0
                            </p>
                        </div>
                    </div>

                    <!-- Features -->
                    <div class="space-y-4 mt-8">
                        <div class="flex items-center gap-3 text-left">
                            <div class="bg-white/20 backdrop-blur-sm rounded-lg p-3">
                                <i class="fas fa-bolt text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold">Conversión Rápida</h3>
                                <p class="text-sm text-purple-100">Resultados instantáneos</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-left">
                            <div class="bg-white/20 backdrop-blur-sm rounded-lg p-3">
                                <i class="fas fa-shield-alt text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold">100% Seguro</h3>
                                <p class="text-sm text-purple-100">Datos protegidos</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-left">
                            <div class="bg-white/20 backdrop-blur-sm rounded-lg p-3">
                                <i class="fas fa-chart-line text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold">Alta Precisión</h3>
                                <p class="text-sm text-purple-100">Cálculos exactos</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side - Login Form -->
            <div class="p-12 flex flex-col justify-center">
                <div class="max-w-md mx-auto w-full">
                    <!-- Header -->
                    <div class="mb-8">
                        <a href="/" class="inline-flex items-center gap-2 text-purple-600 hover:text-purple-800 mb-6 transition-colors">
                            <i class="fas fa-arrow-left"></i>
                            <span class="text-sm font-semibold">Volver al inicio</span>
                        </a>
                        <h2 class="text-3xl font-bold text-gray-800 mb-2">Iniciar Sesión</h2>
                        <p class="text-gray-600">Ingresa tus credenciales para acceder</p>
                    </div>

                    <!-- Login Form -->
                    <form asp-action="Index" method="post" id="loginForm" class="space-y-5">
                        <!-- Usuario -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Usuario</label>
                            <div class="input-group">
                                <i class="fas fa-user input-icon"></i>
                                <input type="text" 
                                       name="usuario" 
                                       id="usuario"
                                       placeholder="Ingresa tu usuario"
                                       class="input-field w-full border-2 border-gray-300 rounded-xl py-3 transition-all duration-300"
                                       required />
                            </div>
                        </div>

                        <!-- Contraseña -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Contraseña</label>
                            <div class="input-group">
                                <i class="fas fa-lock input-icon"></i>
                                <input type="password" 
                                       name="clave" 
                                       id="clave"
                                       placeholder="Ingresa tu contraseña"
                                       class="input-field w-full border-2 border-gray-300 rounded-xl py-3 transition-all duration-300"
                                       required />
                                <button type="button" 
                                        onclick="togglePassword()" 
                                        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-purple-600 transition-colors">
                                    <i class="fas fa-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Recordar sesión y Olvidaste contraseña -->
                        <div class="flex items-center justify-between text-sm">
                            <label class="flex items-center text-gray-700 cursor-pointer">
                                <input type="checkbox" class="mr-2 w-4 h-4 text-purple-600 rounded">
                                <span>Recordarme</span>
                            </label>
                            <a href="#" class="text-purple-600 hover:text-purple-800 font-semibold transition-colors">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <!-- Botón de Login -->
                        <button type="submit" class="btn-login w-full text-white font-bold py-4 rounded-xl flex items-center justify-center gap-3 text-lg">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Iniciar Sesión</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </form>

                    <!-- Footer -->
                    <div class="mt-8 text-center">
                        <p class="text-sm text-gray-600">
                            ¿No tienes una cuenta? 
                            <a href="#" class="text-purple-600 hover:text-purple-800 font-semibold">Regístrate aquí</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('clave');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Mostrar toast de error si existe
        @if (ViewBag.Error != null)
        {
            <text>
            Toastify({
                text: "@ViewBag.Error",
                duration: 4000,
                gravity: "top",
                position: "right",
                style: {
                    background: "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)",
                    borderRadius: "12px",
                    padding: "16px 24px",
                    fontWeight: "600",
                    boxShadow: "0 10px 25px rgba(239, 68, 68, 0.3)"
                },
                onClick: function(){}
            }).showToast();
            </text>
        }

        // Mostrar toast de logout exitoso
        @if (TempData["LogoutSuccess"] != null)
        {
            <text>
            Toastify({
                text: "✓ Sesión cerrada correctamente. ¡Hasta pronto!",
                duration: 4000,
                gravity: "top",
                position: "right",
                style: {
                    background: "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)",
                    borderRadius: "12px",
                    padding: "16px 24px",
                    fontWeight: "600",
                    boxShadow: "0 10px 25px rgba(59, 130, 246, 0.3)"
                }
            }).showToast();
            </text>
        }

        // Animación al enviar formulario
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const button = this.querySelector('button[type="submit"]');
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Iniciando sesión...</span>';
            button.disabled = true;
        });
    </script>
</body>
</html>
