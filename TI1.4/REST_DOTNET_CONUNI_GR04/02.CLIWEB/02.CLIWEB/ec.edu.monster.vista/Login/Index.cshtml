@{
    ViewData["Title"] = "Conversor de Unidades - Iniciar Sesión";
    Layout = null; // usa tu _Layout si lo prefieres
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Estilo unificado (mismo del resto de páginas que emulan el JSP) -->
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="login-bg">
    <div class="login-container">
        <div class="login-card floating">
            <img src="~/images/sullivan.jpg" alt="Avatar" class="avatar" />
            <h1>¡Bienvenido!</h1>
            <p>Conversor de Unidades</p>

            <form asp-action="Index" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="input-group">
                    <input type="text" id="usuario" name="usuario" placeholder="Usuario" autocomplete="username" required />
                </div>
                <div class="input-group">
                    <input type="password" id="clave" name="clave" placeholder="Contraseña" autocomplete="current-password" required />
                </div>

                <button type="submit" class="btn-login">INICIAR SESIÓN</button>

                <p class="note">Por favor, ingrese sus credenciales</p>

                @* Equivalente a sessionScope.loginError del JSP *@
                @if (ViewBag.Error is string err && !string.IsNullOrWhiteSpace(err))
                {
                    <p class="alert">@err</p>
                }
                else if (TempData["LoginError"] is string tempErr && !string.IsNullOrWhiteSpace(tempErr))
                {
                    <p class="alert">@tempErr</p>
                }
            </form>
        </div>
    </div>

    @* Si quieres un pequeño mensaje flotante tipo toast, puedes usar la clase .banner ya incluida en styles.css del resto del proyecto *@
</body>
</html>
