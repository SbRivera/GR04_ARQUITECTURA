<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_02.CLIMOV.Vista.ConversionPage"
             Title="Conversión de Unidades"
             Shell.NavBarIsVisible="False">

    <!-- Fondo con gradiente morado igual al login -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6B46C1" Offset="0.0" />
            <GradientStop Color="#8B5CF6" Offset="0.3" />
            <GradientStop Color="#A78BFA" Offset="0.7" />
            <GradientStop Color="#C4B5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header con título y botón de cerrar sesión en contenedor blanco -->
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       HasShadow="True"
                       Padding="20,15"
                       BorderColor="Transparent"
                       Margin="0,20,0,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="Conversión de Unidades"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#6B46C1"
                               VerticalOptions="Center"/>
                        
                        <Button Grid.Column="1"
                                x:Name="BtnCerrarSesion"
                                Text="Cerrar sesión"
                                Clicked="OnCerrarSesionClicked"
                                BackgroundColor="#3B82F6"
                                TextColor="White"
                                CornerRadius="10"
                                FontSize="14"
                                FontAttributes="Bold"
                                Padding="20,8"
                                VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Label x:Name="LabelUsuario"
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.9"
                       IsVisible="False"
                       Margin="0,0,0,10"/>

                <!-- Tarjeta Azul - Categoría de Conversión -->
                <Frame CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       BorderColor="Transparent"
                       Margin="0,0,0,0">
                    <VerticalStackLayout Spacing="0">
                        <!-- Header Azul -->
                        <Grid BackgroundColor="#3B82F6" 
                              Padding="20,15"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Frame Grid.Column="0"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   BackgroundColor="White"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="ℹ️"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="Categoría de Conversión"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Grid>
                        
                        <!-- Contenido Blanco -->
                        <VerticalStackLayout BackgroundColor="White" Padding="20,25">
                            <Border Stroke="#3B82F6"
                                    StrokeThickness="2"
                                    BackgroundColor="White"
                                    Padding="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Picker x:Name="PickerTipoConversion"
                                        FontSize="18"
                                        TextColor="#1F2937"
                                        SelectedIndexChanged="OnTipoConversionChanged"
                                        Title="Seleccionar Categoría">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>📏 Longitud</x:String>
                                            <x:String>🌡️ Temperatura</x:String>
                                            <x:String>⚖️ Peso</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tarjeta Naranja - Tipo de Conversión -->
                <Frame CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="0">
                        <!-- Header Naranja -->
                        <Grid BackgroundColor="#F97316" 
                              Padding="20,15"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Frame Grid.Column="0"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   BackgroundColor="White"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="🔄"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="Tipo de Conversión"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Grid>
                        
                        <!-- Contenido Blanco -->
                        <VerticalStackLayout BackgroundColor="White" Padding="20,25">
                            <Border Stroke="#F97316"
                                    StrokeThickness="2"
                                    BackgroundColor="White"
                                    Padding="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Picker x:Name="PickerConversionDirecta"
                                        FontSize="16"
                                        TextColor="#1F2937"
                                        SelectedIndexChanged="OnConversionDirectaChanged"
                                        Title="Seleccionar conversión">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Centímetros → Pulgadas</x:String>
                                            <x:String>Pulgadas → Centímetros</x:String>
                                            <x:String>Celsius → Fahrenheit</x:String>
                                            <x:String>Fahrenheit → Celsius</x:String>
                                            <x:String>Kilogramos → Libras</x:String>
                                            <x:String>Libras → Kilogramos</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tarjeta Verde - Ingrese el Valor -->
                <Frame CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="0">
                        <!-- Header Verde -->
                        <Grid BackgroundColor="#10B981" 
                              Padding="20,15"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Frame Grid.Column="0"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   BackgroundColor="White"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="ℹ️"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="Ingrese el Valor"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Grid>
                        
                        <!-- Contenido Blanco -->
                        <VerticalStackLayout BackgroundColor="White" Padding="20,25" Spacing="20">
                            <Border Stroke="#10B981"
                                    StrokeThickness="2"
                                    BackgroundColor="White"
                                    Padding="12,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EntryValor"
                                       Placeholder="Ingrese el valor numérico"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="#1F2937"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       ClearButtonVisibility="WhileEditing"/>
                            </Border>
                            
                            <!-- Botón Convertir -->
                            <Button x:Name="BtnConvertir"
                                    Text="CONVERTIR"
                                    Clicked="OnConvertirClicked"
                                    HeightRequest="55"
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    TextColor="White"
                                    BackgroundColor="#3B82F6"
                                    CornerRadius="12">
                                <Button.Shadow>
                                    <Shadow Brush="#3B82F6"
                                            Opacity="0.4"
                                            Radius="8"
                                            Offset="0,3"/>
                                </Button.Shadow>
                            </Button>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                 IsRunning="False"
                                 IsVisible="False"
                                 Color="#FFFFFF"
                                 HeightRequest="45"
                                 Margin="0,10"/>

                    <!-- Frame de Resultado -->
                    <Frame x:Name="FrameResultado"
                           BorderColor="Transparent"
                           CornerRadius="15"
                           Padding="20"
                           Margin="0,10,0,0"
                           IsVisible="False"
                           HasShadow="True">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0.0" />
                                <GradientStop Color="#059669" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="✨ Resultado de la Conversión"
                                   FontSize="15"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   Opacity="0.95"/>
                            
                            <Label x:Name="LabelResultado"
                                   FontSize="28"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,5,0,0"/>
                            
                            <Label x:Name="LabelDetalles"
                                   FontSize="14"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   Opacity="0.9"
                                   Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

               
                <!-- Footer con texto de bienvenida -->
                <Label Text="¡Bienvenido, Monster!"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,20,0,30"
                       Opacity="0.9"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón flotante de limpieza (Naranja) -->
        <Button x:Name="BtnLimpiar"
                Grid.Row="0"
                Text="🗑️"
                Clicked="OnLimpiarClicked"
                WidthRequest="70"
                HeightRequest="70"
                CornerRadius="35"
                FontSize="32"
                BackgroundColor="#F97316"
                BorderColor="Transparent"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,25,25">
            <Button.Shadow>
                <Shadow Brush="#F97316"
                        Opacity="0.5"
                        Radius="15"
                        Offset="0,5"/>
            </Button.Shadow>
        </Button>
    </Grid>

</ContentPage>
